{% comment %} FBC blog listing — "Advice & Guides" — brief §9 {% endcomment %}
{{ 'fbc-pages.css' | asset_url | stylesheet_tag }}

{% render 'fbc-breadcrumbs' %}

<div class="fbc-blog">
  <header class="fbc-page-head">
    <span class="fbc-eyebrow fbc-page-head__eyebrow">Advice &amp; Guides</span>
    <h1>{{ blog.title }}</h1>
    {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
  </header>

  <div class="page-width">
    {%- paginate blog.articles by 12 -%}
      <div class="fbc-blog__grid">
        {%- for article in blog.articles -%}
          <a class="fbc-article-card" href="{{ article.url }}">
            <span class="fbc-article-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: article.title | escape }}
              {%- else -%}
                <span class="fbc-article-card__media fbc-tiles__image--placeholder" style="display:block;height:100%"></span>
              {%- endif -%}
            </span>
            <span class="fbc-article-card__meta">{{ article.published_at | date: '%-d %B %Y' }}</span>
            <span class="fbc-article-card__title">{{ article.title }}</span>
            <span class="fbc-article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</span>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="fbc-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="fbc-pagination__link" href="{{ paginate.previous.url }}" rel="prev">← Previous</a>{%- endif -%}
          <ul class="fbc-pagination__list" role="list">
            {%- for part in paginate.parts -%}
              <li>{% if part.is_link %}<a class="fbc-pagination__num" href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span class="fbc-pagination__num is-current" aria-current="page">{{ part.title }}</span>{% else %}<span class="fbc-pagination__num fbc-pagination__num--gap">{{ part.title }}</span>{% endif %}</li>
            {%- endfor -%}
          </ul>
          {%- if paginate.next -%}<a class="fbc-pagination__link" href="{{ paginate.next.url }}" rel="next">Next →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Practical advice on choosing, fitting and caring for a freestanding bath." }
  ]
}
{% endschema %}
