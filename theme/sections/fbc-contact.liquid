{% comment %} FBC contact page — form + details card + response promise — brief §9 {% endcomment %}
{{ 'fbc-pages.css' | asset_url | stylesheet_tag }}

{% render 'fbc-breadcrumbs' %}

<div class="fbc-contact">
  <header class="fbc-page-head">
    <span class="fbc-eyebrow fbc-page-head__eyebrow">We're here to help</span>
    <h1>{{ page.title | default: 'Contact us' }}</h1>
    {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
  </header>

  <div class="page-width fbc-contact__grid">
    <div>
      {%- if page.content != blank -%}<div class="rte fbc-prose" style="margin-bottom:var(--space-4)">{{ page.content }}</div>{%- endif -%}
      {%- form 'contact', class: 'fbc-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="fbc-form__success" tabindex="-1" autofocus>Thanks — we've got your message and we'll reply within one working day.</p>
        {%- elsif form.errors -%}
          <p class="fbc-form__error" tabindex="-1" autofocus>{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="fbc-field fbc-field--row">
          <div class="fbc-field">
            <label for="ContactName">Name</label>
            <input type="text" id="ContactName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name" required>
          </div>
          <div class="fbc-field">
            <label for="ContactPhone">Phone (optional)</label>
            <input type="tel" id="ContactPhone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% endif %}" autocomplete="tel">
          </div>
        </div>
        <div class="fbc-field">
          <label for="ContactEmail">Email</label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
        </div>
        <div class="fbc-field">
          <label for="ContactBody">How can we help?</label>
          <textarea id="ContactBody" name="contact[body]" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>
        <div>
          <button type="submit" class="button button--primary">Send message</button>
        </div>
      {%- endform -%}
    </div>

    <aside class="fbc-contact__card">
      <h2>Talk to a specialist</h2>
      {%- if section.settings.phone != blank -%}
        <p class="fbc-contact__detail">{% render 'fbc-icon', icon: 'phone', class: 'fbc-icon' %} <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a></p>
      {%- endif -%}
      <p class="fbc-contact__detail">{% render 'fbc-icon', icon: 'mail', class: 'fbc-icon' %} <a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
      {%- if section.settings.hours != blank -%}
        <p class="fbc-contact__detail">{% render 'fbc-icon', icon: 'chat', class: 'fbc-icon' %} <span>{{ section.settings.hours }}</span></p>
      {%- endif -%}
      {%- if section.settings.address != blank -%}
        <p class="fbc-contact__detail">{% render 'fbc-icon', icon: 'bath', class: 'fbc-icon' %} <span>{{ section.settings.address }}</span></p>
      {%- endif -%}
      <p class="fbc-contact__promise">{{ section.settings.promise | default: 'We reply to every enquiry within one working day — usually much sooner.' }}</p>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Questions about sizing, delivery or finance? Send us a note and a bath specialist will get back to you." },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "hours", "label": "Opening hours", "default": "Mon–Fri, 9am–5pm" },
    { "type": "text", "id": "address", "label": "Address / showroom" },
    { "type": "textarea", "id": "promise", "label": "Response promise", "default": "We reply to every enquiry within one working day — usually much sooner." }
  ]
}
{% endschema %}
