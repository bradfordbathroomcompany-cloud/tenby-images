{% comment %} FBC rotating announcement bar — brief §3, max 3 messages {% endcomment %}

<fbc-announcement-bar class="fbc-announcement fbc-inverse" data-interval="{{ section.settings.interval | times: 1000 }}" role="region" aria-label="Announcements">
  <div class="page-width fbc-announcement__inner">
    {%- assign shown = 0 -%}
    {%- for block in section.blocks limit: 3 -%}
      {%- if block.settings.text != blank -%}
        <p class="fbc-announcement__message{% if shown == 0 %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if shown > 1 -%}
      <button type="button" class="fbc-announcement__pause" data-announcement-pause aria-label="Pause announcements">
        <span class="fbc-announcement__pause-icon" aria-hidden="true"></span>
      </button>
    {%- endif -%}
  </div>
</fbc-announcement-bar>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "range", "id": "interval", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on every order — 3–5 working days" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free UK delivery on every order — 3–5 working days", "link": "/pages/delivery-information" } },
        { "type": "announcement", "settings": { "text": "Next-day upgrade available on eligible baths", "link": "/pages/delivery-information" } },
        { "type": "announcement", "settings": { "text": "Finance available — spread the cost", "link": "/pages/finance" } }
      ]
    }
  ]
}
{% endschema %}
