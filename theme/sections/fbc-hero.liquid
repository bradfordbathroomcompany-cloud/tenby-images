{% comment %} FBC full-bleed hero — brief §4.1 {% endcomment %}
{{ 'fbc-home.css' | asset_url | stylesheet_tag }}

<section class="fbc-hero{% if section.settings.ken_burns %} fbc-hero--kenburns{% endif %} fbc-hero--{{ section.settings.height }}">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 3200
      | image_tag:
        class: 'fbc-hero__image',
        widths: '750, 1100, 1500, 1780, 2000, 2600, 3200',
        sizes: '100vw',
        fetchpriority: 'high',
        preload: true,
        alt: section.settings.image.alt
    }}
  {%- else -%}
    <div class="fbc-hero__image fbc-hero__image--placeholder"></div>
  {%- endif -%}
  <div class="fbc-hero__scrim" aria-hidden="true"></div>

  <div class="fbc-hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="fbc-eyebrow fbc-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="fbc-hero__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="fbc-hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="fbc-hero__ctas">
      {%- if section.settings.cta_primary_label != blank -%}
        <a class="button button--primary" href="{{ section.settings.cta_primary_url }}">{{ section.settings.cta_primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta_secondary_label != blank -%}
        <a class="button button--secondary fbc-hero__cta-secondary" href="{{ section.settings.cta_secondary_url }}">{{ section.settings.cta_secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section section--flush",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "ken_burns", "label": "Slow Ken Burns zoom", "default": true, "info": "Disabled automatically for visitors who prefer reduced motion." },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "large",
      "options": [
        { "value": "medium", "label": "Medium (65vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "full", "label": "Full screen" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Freestanding Bath Co" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Home of Statement Baths" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Freestanding baths chosen for character, comfort and craft — free UK delivery in 3–5 working days on every one." },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button label", "default": "Shop All Baths" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary button link", "default": "/collections/all-freestanding-baths" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button label", "default": "Find Your Style" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary button link", "default": "/pages/buying-guide" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
