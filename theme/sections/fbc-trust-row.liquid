{% comment %} FBC trust icon row — brief §4.2 {% endcomment %}
{{ 'fbc-home.css' | asset_url | stylesheet_tag }}

<section class="fbc-trust-row" aria-label="{{ section.settings.aria_label | default: 'Why shop with us' }}">
  <div class="page-width">
    <ul class="fbc-trust-row__list" role="list">
      {%- for block in section.blocks -%}
        <li class="fbc-trust-row__item" {{ block.shopify_attributes }}>
          <span class="fbc-trust-row__icon">{% render 'fbc-icon', icon: block.settings.icon %}</span>
          <div class="fbc-trust-row__copy">
            <strong>{{ block.settings.heading }}</strong>
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust icon row",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Why shop with us"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Delivery van" },
            { "value": "bolt", "label": "Lightning bolt" },
            { "value": "card", "label": "Payment card" },
            { "value": "chat", "label": "Chat bubble" },
            { "value": "shield", "label": "Guarantee shield" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "star", "label": "Star" },
            { "value": "bath", "label": "Bath" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free Delivery" },
        { "type": "text", "id": "text", "label": "Supporting text", "default": "3–5 working days, every order" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust icon row",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "heading": "Free Delivery", "text": "3–5 working days, every order" } },
        { "type": "item", "settings": { "icon": "bolt", "heading": "Next-Day Upgrade", "text": "On eligible baths" } },
        { "type": "item", "settings": { "icon": "card", "heading": "Finance Available", "text": "Spread the cost at checkout" } },
        { "type": "item", "settings": { "icon": "chat", "heading": "Expert Advice", "text": "Bath specialists, not call centres" } }
      ]
    }
  ]
}
{% endschema %}
