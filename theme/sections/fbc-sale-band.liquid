{% comment %} FBC sale band — brief §4.6 {% endcomment %}
{{ 'fbc-home.css' | asset_url | stylesheet_tag }}

<section class="fbc-sale-band">
  <div class="page-width fbc-sale-band__inner">
    <div class="fbc-sale-band__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="fbc-eyebrow fbc-sale-band__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="fbc-sale-band__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="fbc-sale-band__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <a class="button button--primary fbc-sale-band__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Sale band",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "While they last" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Statement Bath Sale" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "End-of-line designs — brand new, fully guaranteed, and still delivered free." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the Sale" },
    { "type": "url", "id": "cta_url", "label": "Button link", "default": "/collections/sale-clearance" }
  ],
  "presets": [{ "name": "Sale band" }]
}
{% endschema %}
