{% comment %} FBC password page — full-bleed image, logotype, email capture — brief §9 {% endcomment %}
{{ 'fbc-pages.css' | asset_url | stylesheet_tag }}

<div class="fbc-password">
  <div class="fbc-password__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', fetchpriority: 'high', alt: shop.name }}
    {%- endif -%}
    <div class="fbc-password__scrim"></div>
  </div>

  <div class="fbc-password__inner">
    <div>
      <p class="fbc-password__logotype">{{ section.settings.logotype | default: shop.name }}</p>
      <p class="fbc-password__micro">{{ section.settings.microline | default: 'Est. specialists in statement baths' }}</p>
      <p class="fbc-password__tagline">{{ section.settings.tagline | default: 'The home of statement baths — opening soon.' }}</p>

      {%- form 'storefront_password', class: 'fbc-password__form' -%}
        <label class="fbc-visually-hidden" for="PasswordEmail">Email</label>
        {%- comment -%} storefront_password form is for entering the shop; email capture uses customer form below {%- endcomment -%}
      {%- endform -%}

      {%- form 'customer', class: 'fbc-password__form' -%}
        <input type="hidden" name="contact[tags]" value="prospect, opening-soon">
        <label class="fbc-visually-hidden" for="PasswordSignupEmail">Email address</label>
        <input type="email" id="PasswordSignupEmail" name="contact[email]" placeholder="Your email address" required>
        <button type="submit" class="button button--primary">Notify me</button>
        {%- if form.posted_successfully? -%}
          <p style="flex-basis:100%;color:#fff;margin-top:1rem">Thank you — we'll be in touch when we open.</p>
        {%- endif -%}
      {%- endform -%}

      <p class="fbc-password__enter">
        <a href="#" onclick="document.querySelector('.fbc-password__gate').hidden=false;this.hidden=true;return false;">Enter using password</a>
      </p>
      <div class="fbc-password__gate" hidden>
        {%- form 'storefront_password', class: 'fbc-password__form' -%}
          <label class="fbc-visually-hidden" for="PasswordGate">Store password</label>
          <input type="password" id="PasswordGate" name="password" placeholder="Password">
          <button type="submit" class="button button--primary">Enter</button>
          {{ form.errors | default_errors }}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "logotype", "label": "Logotype", "default": "Freestanding Bath Co" },
    { "type": "text", "id": "microline", "label": "Microline", "default": "Est. specialists in statement baths" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The home of statement baths — opening soon." }
  ]
}
{% endschema %}
