{% comment %} FBC collection tile grid — brief §4.3 {% endcomment %}
{{ 'fbc-home.css' | asset_url | stylesheet_tag }}

<section class="fbc-section page-width">
  <header class="fbc-section-header">
    {%- if section.settings.eyebrow != blank -%}<span class="fbc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  </header>

  <ul class="fbc-tiles" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        assign tile_image = block.settings.image | default: col.featured_image
        assign tile_label = block.settings.label | default: col.title
      -%}
      <li class="fbc-tiles__item" {{ block.shopify_attributes }}>
        <a class="fbc-tiles__link" href="{{ col.url | default: block.settings.link }}">
          <span class="fbc-tiles__media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 900
                | image_tag:
                  widths: '360, 540, 720, 900',
                  sizes: '(min-width: 990px) 25vw, 50vw',
                  loading: 'lazy',
                  class: 'fbc-tiles__image',
                  alt: tile_label
              }}
            {%- else -%}
              <span class="fbc-tiles__image fbc-tiles__image--placeholder"></span>
            {%- endif -%}
          </span>
          <span class="fbc-tiles__label">
            {{ tile_label }}
            {% render 'fbc-icon', icon: 'arrow', class: 'fbc-icon fbc-tiles__arrow' %}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Collection tile grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by shape, material and style" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore Our Collections" },
    { "type": "textarea", "id": "text", "label": "Intro text" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Overrides the collection image." },
        { "type": "text", "id": "label", "label": "Custom label", "info": "Overrides the collection title." },
        { "type": "url", "id": "link", "label": "Fallback link", "info": "Used only if no collection is chosen." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tile grid",
      "blocks": [
        { "type": "tile", "settings": { "collection": "roll-top-baths" } },
        { "type": "tile", "settings": { "collection": "slipper-baths" } },
        { "type": "tile", "settings": { "collection": "boat-bateau-baths" } },
        { "type": "tile", "settings": { "collection": "back-to-wall-freestanding-baths" } },
        { "type": "tile", "settings": { "collection": "freestanding-shower-baths" } },
        { "type": "tile", "settings": { "collection": "stone-stone-resin-baths" } },
        { "type": "tile", "settings": { "collection": "copper-baths" } },
        { "type": "tile", "settings": { "collection": "freestanding-bath-taps" } }
      ]
    }
  ]
}
{% endschema %}
