{% comment %} FBC featured products carousel — brief §4.5 "Signature Baths" {% endcomment %}
{{ 'fbc-home.css' | asset_url | stylesheet_tag }}

<section class="fbc-section page-width">
  <header class="fbc-section-header fbc-section-header--split">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="fbc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="fbc-link fbc-section-header__link" href="{{ section.settings.collection.url | default: '/collections/all-freestanding-baths' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </header>

  <ul class="fbc-carousel" role="list">
    {%- assign feature_collection = section.settings.collection | default: collections['all-freestanding-baths'] -%}
    {%- for product in feature_collection.products limit: section.settings.limit -%}
      <li>
        {% render 'fbc-card-product',
          card_product: product,
          sizes: '(min-width: 990px) 24vw, (min-width: 750px) 38vw, 72vw'
        %}
      </li>
    {%- else -%}
      {%- for i in (1..4) -%}
        <li>
          <article class="fbc-card">
            <div class="fbc-card__media"><span class="fbc-card__image fbc-card__image--placeholder"></span></div>
            <div class="fbc-card__info">
              <h3 class="fbc-card__title">Example bath</h3>
              <div class="fbc-card__price"><span class="fbc-price">£899</span></div>
            </div>
          </article>
        </li>
      {%- endfor -%}
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hand-picked by our specialists" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Signature Baths" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "View-all link label", "default": "View all baths" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
